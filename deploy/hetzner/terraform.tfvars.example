# ============================================================================
# KISS Mail - Hetzner Cloud Variables
# ============================================================================

# Hetzner Cloud API token
hcloud_token = "your-hetzner-api-token"

# Location
# nbg1 = Nuremberg, fsn1 = Falkenstein, hel1 = Helsinki, ash = Ashburn,
# hil = Hillsboro, sin = Singapore
location = "nbg1"

# Server type
# cx22 = 2 vCPU, 4GB RAM (default)
# cx32 = 4 vCPU, 8GB RAM
server_type = "cx22"

# The KISS Mail admin password is generated on the server and saved in the
# root-only /opt/kiss-mail/credentials.txt (it is not a Terraform variable).

# Mail domain
domain = "mail.example.com"

# SSH key names (optional, must exist in Hetzner)
# ssh_keys = ["my-key"]
